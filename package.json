{
  "name": "mappy.news",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Location-based local incident news on an interactive map, with an AI news bot and a moderated review queue.",
  "homepage": "https://mappy.news",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/copy-vendor.mjs && next dev",
    "build": "node scripts/copy-vendor.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "validate": "pnpm check && pnpm build && pnpm build:worker && pnpm build:scripts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "make-admin": "tsx scripts/make-admin.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch --clear-screen=false src/worker/index.ts",
    "worker:once": "tsx src/worker/index.ts --once",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/worker.cjs --log-level=warning",
    "build:scripts": "esbuild scripts/migrate.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/migrate.cjs --log-level=warning && esbuild scripts/seed.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/seed.cjs --log-level=warning"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.85",
    "@ai-sdk/deepseek": "^3.0.70",
    "@ai-sdk/google": "^4.0.102",
    "@ai-sdk/openai": "^4.0.99",
    "@ai-sdk/xai": "^5.0.27",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@hookform/resolvers": "^6.0.0",
    "@next/env": "^16.4.2",
    "@tanstack/react-query": "^5.104.5",
    "ai": "^7.0.148",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "geist": "^1.8.1",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "react-map-gl": "^8.1.3",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@parcel/watcher",
      "@swc/core",
      "unrs-resolver"
    ]
  }
}
