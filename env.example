# mappy.news environment template — copy to .env and fill in. Never commit real values.

# --- Runtime
NODE_ENV=development
# Public origin of the site (used for auth callbacks, emails, sitemaps and OG images)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database
# Local: `pnpm db:up` starts PostgreSQL on 54329 (see docker-compose.yml)
DATABASE_URL=postgres://mappy:mappy@localhost:54329/mappy_news
DATABASE_POOL_MAX=10

# --- Auth (Better Auth)
# openssl rand -base64 48
BETTER_AUTH_SECRET=
# Comma-separated; these accounts become admins when they sign up (or run `pnpm make-admin <email>`)
ADMIN_EMAILS=
# Google OAuth (optional). Authorized redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend). Without a key, emails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM="mappy.news <noreply@mappy.news>"

# --- News bot (worker)
# AI provider keys. The provider and model are chosen in Admin → News bot → Settings; only the chosen
# provider is used (no automatic fallback), so its key needs credit.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
# X API v2 app bearer token (optional; RSS sources work without it)
X_BEARER_TOKEN=
# Comma-separated X handles created as sources by `pnpm db:seed`
SEED_X_ACCOUNTS=
# Protects /api/cron/bot for schedulers that cannot run the worker process
CRON_SECRET=
# Geocoding on OpenStreetMap: Nominatim (addresses, street geometry) and Photon (named places). The public
# instances allow about one request per second; for volume, self-host them and set GEOCODER_FAST=true.
# OVERPASS_URL is optional and only for a self-hosted Overpass (exact junction nodes); the public instance asks
# automated users to run their own. An empty PHOTON_URL switches Photon off.
NOMINATIM_URL=https://nominatim.openstreetmap.org
PHOTON_URL=https://photon.komoot.io
OVERPASS_URL=
GEOCODER_FAST=false
GEOCODER_CONTACT_EMAIL=
